<div aria-hidden="true" aria-labelledby="editPriceListModalLabel" class="modal fade" id="editPriceListModal" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          Prijslijst wijzigen
        </h5>
        <button aria-label="Close" class="btn-close" data-bs-dismiss="modal" type="button"/>
      </div>
      <form :action="url" method="post">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Naam *</label>
            <input class="form-control" name="price_list[name]" v-model="name" required="true" placeholder="Naam">
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal" type="button">
            Annuleren
          </button>
          <button class="btn btn-primary" type="submit" data-disable-with="Bezig...">
            Naam wijzigen
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
